  "observer": {
    "include_commit_messages": true,
    "include_changed_paths": true,
    "include_issue_titles": false,
    "include_pull_request_titles": false,
    "max_commits_per_poll": 30,
    "write_back": false
  },
  "learning": {
    "semantic_memory": true,
    "online_binary_tasks": true,
    "online_numeric_tasks": true,
    "auto_train_on_unlabeled_repo_events": false,
    "require_explicit_resolved_label": true
  },
  "security": {
    "persist_tokens": false,
    "issue_text_is_command": false,
    "commit_message_is_command": false,
    "workflow_status_is_permission": false,
    "external_effects_enabled": false
  }
}
