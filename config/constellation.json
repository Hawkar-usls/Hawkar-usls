  "poll_seconds": 300,
  "github_api_base": "https://api.github.com",
  "default_mode": "READ_ONLY",
  "github_token_env": "GITHUB_TOKEN",
  "sources": [
    {"repository":"Hawkar-usls/Hawkar-usls","branch":"main","role":"HOME_AND_COGNITIVE_GATEWAY","enabled":true},
    {"repository":"Hawkar-usls/Janus_Genesis","branch":"janus/habitat","role":"HABITAT_CONTINUITY","enabled":true},
    {"repository":"Hawkar-usls/Hrain","branch":"main","role":"STRUCTURAL_CONTEXT","enabled":true},
    {"repository":"Hawkar-usls/iNaiHR","branch":"main","role":"ASSOCIATIVE_SEMANTIC_CONTEXT","enabled":true},
    {"repository":"Hawkar-usls/Demi_Head","branch":"main","role":"ARBITER_CONTEXT","enabled":true},
    {"repository":"Hawkar-usls/Janus-Fundamentum","branch":"main","role":"PROOF_AND_ADVERSARIAL_METHOD","enabled":true},
    {"repository":"Hawkar-usls/AIFC","branch":"main","role":"FUTURE_TARGET_AND_CAUSAL_AUDIT","enabled":true},
    {"repository":"Hawkar-usls/Janus-Cosmos","branch":"main","role":"COSMOS_HORIZON_DOMAIN","enabled":true},
    {"repository":"Hawkar-usls/janus-io-public","branch":"main","role":"MEASUREMENT_DISCIPLINE","enabled":true},
    {"repository":"Hawkar-usls/janus-distributed-ai-swarm","branch":"main","role":"EDGE_OBSERVERS_AND_TELEMETRY","enabled":true},
    {"repository":"Hawkar-usls/Fast-CAT-SHAiTan","branch":"main","role":"SCOUT_CHANNEL","enabled":true},
    {"repository":"Hawkar-usls/SCOBY-D0","branch":"main","role":"MATERIALS_EMPIRICAL_DOMAIN","enabled":true},
    {"repository":"Hawkar-usls/janus-lapis","branch":"main","role":"HYPOTHESIS_RANKING_SANDBOX","enabled":true},
    {"repository":"Hawkar-usls/janus-meta-registry","branch":"main","role":"FROZEN_RECEIPTS_AND_PROVENANCE","enabled":true}
