{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "janus.activator.ack_authenticated_final_receipt.v0.6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "finalization_id", "created_at", "parent_finalization_hash",
    "structural_reconciliation_receipt_hash", "provenance_receipt_hash",
    "packet_id", "packet_hash", "ack_hash", "ack_accepted", "ack_terminal",
    "source_authenticated_under_github_trust_model", "delivery_confirmed_under_github_trust_model",
    "transport_ambiguity_resolved", "target_execution_authorized", "target_execution_inferred",
    "target_execution_observed", "claim_authority_granted", "scientific_evidence_authority_granted",
    "external_effect_authorized", "terminal", "reasons", "receipt_hash"
  ],
  "properties": {
    "schema": {"const": "janus.activator.ack_authenticated_final_receipt.v0.6"},
    "finalization_id": {"type": "string", "pattern": "^ackf-[0-9a-f]{64}$"},
    "created_at": {"type": "number", "minimum": 0},
    "parent_finalization_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "structural_reconciliation_receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance_receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "packet_id": {"type": "string", "minLength": 1},
    "packet_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ack_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ack_accepted": {"type": "boolean"},
    "ack_terminal": {"type": "string", "minLength": 1},
    "source_authenticated_under_github_trust_model": {"type": "boolean"},
    "delivery_confirmed_under_github_trust_model": {"type": "boolean"},
    "transport_ambiguity_resolved": {"type": "boolean"},
    "target_execution_authorized": {"const": false},
    "target_execution_inferred": {"const": false},
    "target_execution_observed": {"const": false},
    "claim_authority_granted": {"const": false},
    "scientific_evidence_authority_granted": {"const": false},
    "external_effect_authorized": {"const": false},
    "terminal": {
      "enum": [
        "ACK_AUTHENTICATED_DELIVERY_CONFIRMED_NO_EXECUTION",
        "ACK_AUTHENTICATED_REJECTION_CONFIRMED_NO_EXECUTION",
        "ACK_AUTHENTICATED_FINALIZATION_ALREADY_RECORDED",
        "ACK_AUTHENTICATED_FINALIZATION_BLOCKED_INVALID_STRUCTURAL_RECEIPT",
        "ACK_AUTHENTICATED_FINALIZATION_BLOCKED_STRUCTURAL_RECEIPT_NOT_LOCAL",
        "ACK_AUTHENTICATED_FINALIZATION_BLOCKED_INVALID_PROVENANCE_RECEIPT",
        "ACK_AUTHENTICATED_FINALIZATION_BLOCKED_PROVENANCE_RECEIPT_NOT_LOCAL",
        "ACK_AUTHENTICATED_FINALIZATION_BLOCKED_SOURCE_UNAUTHENTICATED",
        "ACK_AUTHENTICATED_FINALIZATION_BLOCKED_LINEAGE_MISMATCH",
        "ACK_AUTHENTICATED_FINALIZATION_BLOCKED_INCONSISTENT_ACK_STATE"
      ]
    },
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
