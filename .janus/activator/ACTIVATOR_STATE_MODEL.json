{
  "schema": "janus.activator.state_model.v0.2",
  "status": "PROVISIONAL_RUNTIME_CONTRACT",
  "state_vector": [
    {
      "axis": "LIFECYCLE",
      "states": ["DORMANT", "WAKING", "ORIENTING", "GOVERNING", "ROUTING", "CHECKPOINTING", "SLEEPING"],
      "terminal_default": "DORMANT"
    },
    {
      "axis": "COGNITION",
      "source": "config/JANUS_INTELLIGENCE_STEP_POLICY-v1.0.json",
      "states": [
        "INGEST_INTENT", "CLASSIFY_ENVIRONMENT", "LOAD_PROVENANCE_AND_STATE", "OBSERVE_STRUCTURE",
        "GENERATE_BOUNDED_CANDIDATES", "BUILD_MINIMUM_TESTABLE_MODEL", "ROUTE_SPECIALIZED_GATES",
        "FORWARD_CONSTRUCTION_PASS", "REVERSE_ADVERSARIAL_PASS", "EVIDENCE_DIVERSITY_AND_INDEPENDENCE_CHECK",
        "DEMIHEAD_ARBITRATION", "PRESERVE_FAILURE_AND_SHADOWS", "BOUND_THE_CLAIM", "STATE_DELTA_CHECK",
        "PROMOTE_OR_HOLD", "TRANSFER_SURVIVING_PRINCIPLE", "ORIGIN_PRIME"
      ],
      "note": "Activator coordinates this machine; it does not replace it with a second reasoning pipeline."
    },
    {
      "axis": "EPISTEMIC_CLAIM_STATE",
      "states": [
        "GENERATED_CANDIDATE", "EVIDENCE_INSUFFICIENT", "OBSERVATION_BOUND", "SUPPORTED_WITHIN_SOURCE_SCOPE",
        "COMPUTED_WITHIN_RECEIPT_SCOPE", "ASSOCIATION_SUPPORTED", "CAUSAL_CANDIDATE", "CAUSAL_SUPPORTED_WITHIN_DESIGN",
        "REPLICATED_WITHIN_DECLARED_SCOPE", "FORMALLY_ADMITTED", "CONTESTED", "HOLD_PLURALITY", "NULL", "NEGATIVE",
        "REFUTED_WITHIN_SCOPE", "BLOCKED", "DEFERRED", "BUDGET_EXHAUSTED", "UNRESOLVED"
      ],
      "non_monotonic": true,
      "default": "UNRESOLVED"
    },
    {
      "axis": "CAPABILITY_EFFECT_STATE",
      "states": [
        "NO_CAPABILITY_REQUEST", "CAPABILITY_DISCOVERED", "CAPABILITY_INSPECTED", "CAPABILITY_DECLINED",
        "CAPABILITY_ACTION_PREFLIGHT_REJECTED", "FRESH_HUMAN_REAUTHORIZATION_REQUIRED",
        "CAPABILITY_ACTION_INTENT_DURABLE", "CAPABILITY_ACTION_CALL_ENTERING", "CAPABILITY_ACTION_SETTLED",
        "CAPABILITY_ACTION_OUTCOME_UNDETERMINED"
      ],
      "default": "NO_CAPABILITY_REQUEST",
      "automatic_retry_from_outcome_undetermined": false
    },
    {
      "axis": "RUNTIME_HEALTH",
      "planes": {
        "source_observation": ["UNKNOWN", "OK", "DEGRADED", "UNAVAILABLE"],
        "model_synthesis": ["UNKNOWN", "OK", "DEGRADED", "UNAVAILABLE"],
        "target_transport": ["UNKNOWN", "OK", "DEGRADED", "UNAVAILABLE"],
        "ledger_integrity": ["UNKNOWN", "PASS", "FAIL"]
      },
      "law": "DEGRADATION_IN_ONE_PLANE_DOES_NOT_ERASE_VALID_OBSERVATION_IN_ANOTHER"
    },
    {
      "axis": "ROUTING",
      "states": ["UNROUTED", "ROUTE_PROPOSED", "ROUTE_GATED", "ROUTE_DISPATCHED", "ROUTE_BLOCKED", "ROUTE_COMPLETED"],
      "default": "UNROUTED"
    }
  ],
  "promotion_gate": {
    "requires": [
      "fresh_trigger_or_explicit_historical_replay",
      "provenance_loaded",
      "relevant_specialized_gate",
      "adversarial_pass",
      "claim_bound_to_witness_scope",
      "nonzero_admissible_state_delta",
      "DemiHead arbitration where policy requires it"
    ],
    "does_not_grant_external_effect": true
  }
}
