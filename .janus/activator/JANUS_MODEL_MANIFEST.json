      {"key": "ecology_baseline", "path": "organism/JANUS_REPOSITORY_ECOLOGY_v1.3.json", "required": true},
      {"key": "ecology_delta", "path": "organism/JANUS_REPOSITORY_ECOLOGY_v1.4.json", "required": true},
      {"key": "simptomat_delta", "path": "organism/JANUS_ORGANISM_DELTA_2026-08-26_SIMPTOMAT_v1.json", "required": true},
      {"key": "execution_extension", "path": "organism/JANUS_SPIRAL_TRANCEPTION_v1.4.json", "required": true}
    ]
  },
  "memory_database": {
    "repository": "Hawkar-usls/janus-meta-registry",
