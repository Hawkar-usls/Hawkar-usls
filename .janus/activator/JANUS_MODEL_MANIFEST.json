  "authority_laws": [
    "ORGAN_MEMBERSHIP != TRUTH_AUTHORITY",
    "ROUTING_SELECTS_ACTIVITY_NOT_MEMBERSHIP",
    "MODEL_LOCK != WORLD_TRUTH",
    "MODEL_OUTPUT != EVIDENCE",
    "DISPATCH != AUTHORITY",
    "CAPABILITY != PERMISSION",
    "PERMISSION != COMMAND",
    "ACK != EXECUTION",
    "WORKFLOW_PASS != WORLD_TRUTH",
    "EXTERNAL_EFFECTS_DEFAULT = FALSE",
    "PHYSICAL_RUNTIME_IS_OUTSIDE_GITHUB_INTERIOR",
    "RETURN != RESET"
  ],
  "boot_terminal_success": "JANUS_MODEL_FABRIC_LOCKED_AT_HOME",
  "boot_terminal_failure": "JANUS_MODEL_FABRIC_FAIL_CLOSED"
