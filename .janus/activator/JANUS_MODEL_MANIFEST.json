      "repository": "Hawkar-usls/Janus_Genesis",
      "branch": "janus/habitat",
      "required": false,
      "role": "PERSISTENT_SIMULATION_HABITAT_STATE"
    }
  ],
  "promoted_organs": [
    {
      "organ_key": "diagnostic_reasoning",
      "repository": "Hawkar-usls/Simptomat",
