    "PRIVATE_GATED": "OPTIONAL_ENV_GATED",
    "SUBTISSUE": "LAZY_PARENT_BOUND",
    "PRIVATE_SUBTISSUE": "OPTIONAL_ENV_GATED",
    "TOOLCHAIN_DEPENDENCY": "REFERENCE_ONLY",
    "EXTERNAL_RESEARCH_INSTRUMENT": "REFERENCE_ONLY_WITH_INDEPENDENT_PROVENANCE",
    "LEGACY_ARCHIVE": "MEMORY_LINEAGE_ONLY",
    "PROFILE_NAVIGATION": "NON_ORGAN_METADATA"
  },
  "organ_descriptor_policy": {
    "preferred_path": ".janus/JANUS_ORGANISM_LINK.json",
    "self_description_preferred": true,
    "central_manifest_fallback_allowed": true,
    "descriptor_mismatch": "FAIL_CLOSED_FOR_REQUIRED_CORE",
    "missing_descriptor": "CENTRAL_MANIFEST_FALLBACK_WITH_RECEIPT"
  },
  "model_loading": {
    "membership": "GLOBAL_AT_BOOT",
    "exact_repo_heads": "LOCK_ALL_RESOLVABLE_MEMBERS",
