{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "janus.activator.ack_provenance_receipt.v0.6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "provenance_id", "created_at", "parent_provenance_hash",
    "run_id", "repository", "workflow_id", "workflow_path", "head_sha", "run_event",
    "run_status", "run_conclusion", "workflow_blob_sha", "protocol_blob_sha", "handler_blob_sha",
    "artifact_id", "artifact_name", "artifact_expired", "artifact_archive_sha256",
    "ack_hash", "ack_packet_id", "ack_packet_hash", "ack_accepted", "ack_terminal",
    "source_authenticated", "source_authentication_basis", "trust_model",
    "credential_source", "credential_value_persisted", "target_execution_authorized",
    "target_execution_inferred", "claim_authority_granted", "scientific_evidence_authority_granted",
    "external_effect_authorized", "terminal", "reasons", "receipt_hash"
  ],
  "properties": {
    "schema": {"const": "janus.activator.ack_provenance_receipt.v0.6"},
    "provenance_id": {"type": "string", "pattern": "^ackp-[0-9a-f]{64}$"},
    "created_at": {"type": "number", "minimum": 0},
    "parent_provenance_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": "integer", "minimum": 1},
    "repository": {"type": "string", "minLength": 1},
    "workflow_id": {"type": ["integer", "null"]},
    "workflow_path": {"type": ["string", "null"]},
    "head_sha": {"type": ["string", "null"]},
    "run_event": {"type": ["string", "null"]},
    "run_status": {"type": ["string", "null"]},
    "run_conclusion": {"type": ["string", "null"]},
    "workflow_blob_sha": {"type": ["string", "null"]},
    "protocol_blob_sha": {"type": ["string", "null"]},
    "handler_blob_sha": {"type": ["string", "null"]},
    "artifact_id": {"type": ["integer", "null"]},
    "artifact_name": {"type": ["string", "null"]},
    "artifact_expired": {"type": ["boolean", "null"]},
    "artifact_archive_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "ack_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "ack_packet_id": {"type": ["string", "null"]},
    "ack_packet_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "ack_accepted": {"type": ["boolean", "null"]},
    "ack_terminal": {"type": ["string", "null"]},
    "source_authenticated": {"type": "boolean"},
    "source_authentication_basis": {"type": "string", "minLength": 1},
    "trust_model": {"const": "GITHUB_ACTIONS_PLATFORM_AND_TLS_TRUST_MODEL"},
    "credential_source": {"const": "ENV:JANUS_ACK_PROVENANCE_TOKEN"},
    "credential_value_persisted": {"const": false},
    "target_execution_authorized": {"const": false},
    "target_execution_inferred": {"const": false},
    "claim_authority_granted": {"const": false},
    "scientific_evidence_authority_granted": {"const": false},
    "external_effect_authorized": {"const": false},
    "terminal": {
      "enum": [
        "ACK_SOURCE_AUTHENTICATED_GITHUB_ACTIONS_TRUST_MODEL",
        "ACK_PROVENANCE_BLOCKED_NO_CREDENTIAL",
        "ACK_PROVENANCE_BLOCKED_RUN_METADATA",
        "ACK_PROVENANCE_BLOCKED_UNADMITTED_EVENT",
        "ACK_PROVENANCE_BLOCKED_PIN_MISMATCH",
        "ACK_PROVENANCE_BLOCKED_ARTIFACT",
        "ACK_PROVENANCE_BLOCKED_ARCHIVE",
        "ACK_PROVENANCE_BLOCKED_INVALID_ACK",
        "ACK_PROVENANCE_UNRESOLVED_FETCH_ERROR"
      ]
    },
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
