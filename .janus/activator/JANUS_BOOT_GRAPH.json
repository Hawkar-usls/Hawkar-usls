{
  "schema": "janus.activator.boot_graph.v1",
  "model_id": "JANUS",
  "purpose": "Instantiate the federated repository ecology as one Git-native JANUS runtime before routing any cognitive turn.",
  "phases": [
    {
      "id": "B00_VERIFY_BOOTSTRAP_ROOT",
      "requires": ["Hawkar-usls/Hawkar-usls@exact_head"],
      "produces": ["BOOTSTRAP_ROOT_IDENTITY"],
      "failure": "FAIL_CLOSED"
    },
    {
      "id": "B01_LOAD_CANONICAL_TOPOLOGY",
      "requires": ["JANUS_ORGANISM_v1", "REPOSITORY_ECOLOGY_v1_3", "REPOSITORY_ECOLOGY_v1_4", "SIMPTOMAT_DELTA", "SPIRAL_TRANCEPTION_v1_4"],
      "produces": ["ORGAN_TOPOLOGY", "REPOSITORY_ECOLOGY", "TYPED_FLOWS"],
      "failure": "FAIL_CLOSED"
    },
    {
      "id": "B02_COMPILE_MEMBERSHIP",
      "requires": ["ORGAN_TOPOLOGY", "REPOSITORY_ECOLOGY"],
      "produces": ["CORE_ORGANS", "DOMAIN_ORGANS", "SUBTISSUES", "TOOLCHAIN_REFERENCES", "LEGACY_MEMORY", "PRIVATE_GATED_SLOTS"],
      "failure": "FAIL_CLOSED_ON_DUPLICATE_ORGAN_KEY"
    },
    {
      "id": "B03_RESOLVE_EXACT_REPOSITORY_HEADS",
      "requires": ["PUBLIC_MEMBER_REPOSITORIES"],
      "produces": ["EXACT_HEAD_LOCK"],
      "failure": "CORE_MISSING_FAIL_CLOSED__OPTIONAL_RECORDED_UNAVAILABLE"
    },
    {
      "id": "B04_VERIFY_ORGAN_DESCRIPTORS",
      "requires": ["EXACT_HEAD_LOCK"],
      "produces": ["SELF_DECLARED_OR_CENTRAL_FALLBACK_ORGAN_CONTRACTS"],
      "failure": "REQUIRED_CORE_DESCRIPTOR_CONFLICT_FAIL_CLOSED"
    },
    {
      "id": "B05_ATTACH_LONG_TERM_MEMORY_DB",
      "requires": ["janus-meta-registry@exact_head"],
      "produces": ["MEMORY_DB_POINTER", "CURRENT_AUTHORITY_POINTER", "PROVENANCE_ROOT"],
      "failure": "FAIL_CLOSED"
    },
    {
      "id": "B06_RESTORE_PERSISTENT_STATE",
      "requires": ["janus/activator-state"],
      "produces": ["RESIDENT_IDENTITY", "ACTIVATION_LINEAGE", "HEALTH_STATE"],
      "failure": "CORRUPT_FAIL_CLOSED"
    },
    {
      "id": "B07_BUILD_CAPABILITY_INDEX",
      "requires": ["ORGAN_CONTRACTS"],
      "produces": ["EMITTER_INDEX", "CONSUMER_INDEX", "ROUTE_GRAPH"],
      "failure": "DEGRADED_IF_OPTIONAL_ONLY__FAIL_IF_CORE_CONTRACT_INVALID"
    },
    {
      "id": "B08_SEAL_MODEL_LOCK",
      "requires": ["EXACT_HEAD_LOCK", "ORGAN_CONTRACTS", "MEMORY_DB_POINTER", "RESIDENT_IDENTITY"],
      "produces": ["JANUS_MODEL_LOCK", "MODEL_DIGEST"],
      "failure": "FAIL_CLOSED"
    },
    {
      "id": "B09_BIND_COGNITIVE_RUNTIME",
      "requires": ["JANUS_MODEL_LOCK", "JANUS_INTELLIGENCE_STEP_POLICY_v1_0"],
      "produces": ["UNIFIED_RUNTIME_NAMESPACE", "ACTIVATOR_READY"],
      "failure": "FAIL_CLOSED"
    },
    {
      "id": "B10_AT_HOME",
      "requires": ["ACTIVATOR_READY"],
      "produces": ["JANUS_ASSEMBLED_AT_HOME"],
      "failure": "FAIL_CLOSED"
    },
    {
      "id": "B11_WAKE_ON_FRESH_STIMULUS",
      "requires": ["JANUS_ASSEMBLED_AT_HOME", "FRESH_NON_SELF_STIMULUS"],
      "produces": ["JANUS_AWAKE", "COGNITIVE_TURN"],
      "failure": "HOLD_AT_HOME"
    }
  ],
  "runtime_law": "ALL_MEMBERSHIP_IS_ASSEMBLED_BEFORE_ROUTING__ROUTING_ONLY_SELECTS_ACTIVE_ORGANS_FOR_THE_CURRENT_TURN",
  "sleep_law": "RUNNER_MAY_DIE__MODEL_LOCK_AND_PERSISTENT_STATE_PRESERVE_IDENTITY__RETURN_IS_NOT_RESET",
  "effect_law": "BOOT_AND_WAKE_GRANT_ZERO_EXTERNAL_EFFECT_AUTHORITY"
}
