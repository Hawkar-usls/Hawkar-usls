{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "janus.activator.transport_receipt.v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "transport_id", "created_at", "parent_transport_hash", "packet_id", "packet_hash",
    "target_organ", "endpoint_class", "credential_source", "credential_value_persisted",
    "network_boundary_entered", "automatic_retry_allowed", "terminal", "reasons",
    "external_effect_authorized", "target_execution_authorized", "receipt_hash"
  ],
  "properties": {
    "schema": {"const": "janus.activator.transport_receipt.v0.4"},
    "transport_id": {"type": "string", "pattern": "^tx-[0-9a-f]{64}$"},
    "created_at": {"type": "number", "minimum": 0},
    "parent_transport_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "packet_id": {"type": "string", "pattern": "^dsp-[0-9a-f]{64}$"},
    "packet_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_organ": {"type": "string", "minLength": 1},
    "endpoint_class": {"const": "GITHUB_REPOSITORY_DISPATCH"},
    "credential_source": {"const": "ENV:JANUS_DEMIURGE_DISPATCH_TOKEN"},
    "credential_value_persisted": {"const": false},
    "network_boundary_entered": {"type": "boolean"},
    "automatic_retry_allowed": {"type": "boolean"},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "terminal": {
      "enum": [
        "TRANSPORT_PRE_EFFECT_REJECTED_INVALID_PACKET",
        "TRANSPORT_PRE_EFFECT_REJECTED_UNSUPPORTED_TARGET",
        "TRANSPORT_BLOCKED_NO_CREDENTIAL",
        "TRANSPORT_SENT_AWAITING_ACK",
        "TRANSPORT_OUTCOME_UNDETERMINED",
        "TRANSPORT_REPLAY_BLOCKED"
      ]
    },
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "external_effect_authorized": {"const": false},
    "target_execution_authorized": {"const": false},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
