{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "janus.activator.activation_event.v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_kind", "source_ref", "payload", "classifications", "fresh"],
  "properties": {
    "source_kind": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string", "minLength": 1},
    "payload": {},
    "classifications": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "fresh": {"type": "boolean"},
    "self_generated": {"type": "boolean", "default": false},
    "command_authority": {"type": "boolean", "default": false},
    "effect_authorized": {"type": "boolean", "default": false}
  }
}
