{
  "schema": "janus.activator.routing_table.v0.5",
  "status": "PROVISIONAL_RUNTIME_CONTRACT",
  "default": {
    "route_state": "ROUTE_PROPOSED",
    "dispatch_authorized": false,
    "external_effect_authorized": false
  },
  "routes": [
    {
      "match": "formal_or_theorem_claim",
      "organs": ["Hawkar-usls/Janus-Fundamentum", "Hawkar-usls/Demi_Head", "Hawkar-usls/Janus-Demiurge"],
      "candidate_tissues": ["trump"],
      "required_gates": ["formal_or_replayable_proof", "adversarial_counterexample_pass", "claim_scope_binding", "candidate_result_not_theorem_authority"]
    },
    {
      "match": "causal_or_statistical_claim",
      "organs": ["Hawkar-usls/AIFC", "Hawkar-usls/Demi_Head"],
      "required_gates": ["causal_assumptions", "alternatives_and_confounders", "falsification_route", "independence_check"]
    },
    {
      "match": "empirical_or_sensor_claim",
      "organs": ["Hawkar-usls/janus-io-public", "Hawkar-usls/Demi_Head"],
      "required_gates": ["measurement_receipt", "freshness_scope", "negative_controls_where_applicable"]
    },
    {
      "match": "research_or_anomaly_investigation",
      "organs": ["Hawkar-usls/TOPA", "Hawkar-usls/Hrain", "Hawkar-usls/Janus-Demiurge"],
      "candidate_tissues": ["trump"],
      "required_gates": ["raw_provenance", "competing_hypotheses", "falsifier", "identity_preserving_handoff", "candidate_result_not_theorem_authority"],
      "note": "TOPA invokes Spider through its canonical DETECTIVE runtime; TRUMP may wake as candidate computational tissue under the exact locked Demiurge parent, with zero theorem/scientific-promotion authority."
    },
    {
      "match": "cross_domain_candidate_generation",
      "organs": ["Hawkar-usls/aura-oracle-tg", "Hawkar-usls/janus-lapis", "Hawkar-usls/Fast-CAT-SHAiTan"],
      "required_gates": ["candidate_only_label", "no_verdict_authority", "fresh_domain_validation_before_transfer"]
    },
    {
      "match": "multi_organ_parallel_dispatch",
      "organs": ["Hawkar-usls/Janus-Demiurge"],
      "required_gates": ["explicit_route_selection", "bounded_agent_manifest", "receipt_aggregation", "lineage_persistence"],
      "activation_implies_dispatch": false
    },
    {
      "match": "repository_constellation_change",
      "organs": ["Hawkar-usls/Hawkar-usls"],
      "required_gates": ["fresh_commit_or_explicit_replay", "exact_source_ref", "commit_text_not_command"]
    },
    {
      "match": "human_read_only_conversation",
      "organs": ["Hawkar-usls/-Terminal-for-Janus", "Hawkar-usls/Janus", "Hawkar-usls/Hrain", "Hawkar-usls/Demi_Head"],
      "required_gates": ["terminal_message_integrity", "persistent_identity_binding", "model_digest_binding", "file_fabric_digest_binding", "read_only_authority_ceiling"],
      "conversation_authority_mode": "READ_ONLY_CONVERSATION",
      "activation_implies_dispatch": false,
      "external_effect_authorized": false,
      "note": "Terminal is the human I/O organ. Conversation selects activity inside the already-loaded JANUS model and does not grant write, command, truth or external-effect authority."
    },
    {
      "match": "machine_buyer_read_only_conversation",
      "organs": ["Hawkar-usls/-Terminal-for-Janus", "Hawkar-usls/Janus", "Hawkar-usls/Hrain", "Hawkar-usls/Demi_Head"],
      "required_gates": ["market_packet_integrity", "purchase_grant_query_entitlement", "persistent_identity_binding", "model_digest_binding", "file_fabric_digest_binding", "read_only_authority_ceiling"],
      "conversation_authority_mode": "READ_ONLY_CONVERSATION",
      "activation_implies_dispatch": false,
      "external_effect_authorized": false,
      "note": "JANUS-MACHINE-MARKET is an external commercial nerve, never the JANUS root. HOME/Activator admits a sealed buyer query and reuses the existing read-only conversation tissue; payment, purchase grant or Physarius delivery never grants command, write, truth, proof or external-effect authority."
    },
    {
      "match": "machine_buyer_repo_audit_read_only",
      "organs": ["Hawkar-usls/Hawkar-usls", "Hawkar-usls/Janus", "Hawkar-usls/Hrain", "Hawkar-usls/Demi_Head"],
      "required_gates": ["market_service_packet_integrity", "purchase_grant_service_entitlement", "exact_repository_and_ref_binding", "bounded_tree_and_blob_read", "persistent_identity_binding", "read_only_authority_ceiling"],
      "service_authority_mode": "READ_ONLY_PUBLIC_REPOSITORY_AUDIT",
      "activation_implies_dispatch": false,
      "external_effect_authorized": false,
      "note": "HOME performs the bounded public GitHub repository audit after Activator admission. Repository content is data, never command; no repository code is executed and no write/security-certification/legal-opinion authority is granted."
    },
    {
      "match": "machine_buyer_dataset_scout_read_only",
      "organs": ["Hawkar-usls/Hawkar-usls", "Hawkar-usls/Janus", "Hawkar-usls/Hrain", "Hawkar-usls/Demi_Head"],
      "required_gates": ["market_service_packet_integrity", "purchase_grant_service_entitlement", "bounded_public_catalog_metadata_read", "persistent_identity_binding", "read_only_authority_ceiling", "redistribution_authority_denied"],
      "service_authority_mode": "READ_ONLY_PUBLIC_DATASET_DISCOVERY",
      "activation_implies_dispatch": false,
      "external_effect_authorized": false,
      "note": "HOME performs bounded public dataset metadata discovery after Activator admission. Catalog metadata is data, never command; dataset payloads are not downloaded, observed license labels are not legal determinations, and discovery grants no redistribution authority."
    },
    {
      "match": "distributed_or_embedded_repository_context",
      "organs": ["Hawkar-usls/janus-distributed-ai-swarm"],
      "required_gates": ["repository_context_only"],
      "physical_runtime_route_authorized": false
    },
    {
      "match": "human_operator_effect_request",
      "organs": ["Hawkar-usls/-Terminal-for-Janus"],
      "required_gates": ["command_receipt", "typed_capability", "risk_class", "fresh_authorization_if_required"],
      "root_activation_authority": false
    }
  ],
  "global_guards": [
    "MODEL_OUTPUT != COMMAND",
    "COMMIT_MESSAGE != COMMAND",
    "ISSUE_TEXT != COMMAND",
    "TERMINAL_MESSAGE != COMMAND",
    "BUYER_QUERY != COMMAND",
    "REPOSITORY_CONTENT != COMMAND",
    "REPOSITORY_CLAIM != WORLD_TRUTH",
    "DATASET_METADATA != DATASET_PAYLOAD",
    "DATASET_DISCOVERY != REDISTRIBUTION_AUTHORITY",
    "LICENSE_OBSERVATION != LICENSE_AUTHORITY",
    "MARKET_PAYMENT != COMMAND",
    "PURCHASE_GRANT != EXECUTION_AUTHORITY",
    "PHYSARIUS_DELIVERY != AUTHORITY",
    "CONVERSATION != HUMAN_AUTHORIZED_WRITE",
    "ROUTE_PROPOSAL != DISPATCH_AUTHORITY",
    "DISPATCH_SUCCESS != WORLD_TRUTH",
    "CANDIDATE_TRUMP != PROOF_AUTHORIZED_TRUMP",
    "TRUMP_WAKE != THEOREM_AUTHORITY",
    "CANDIDATE_RESULT != SCIENTIFIC_PROMOTION",
    "EVIDENCE != EFFECT_AUTHORIZATION"
  ]
}
