  "continuous_runtime": {
    "entrypoint": "run_aura_habitat_spiral.py",
    "mode": "EVENT_DRIVEN_DAEMON_OR_ONE_SHOT",
    "default_poll_seconds": 5,
    "idle_behavior": "SILENT_HEARTBEAT_NO_GENERATED_DIALOGUE",
    "inbox_default": "state/aura_spi_inbox.jsonl",
    "dialogue_ledger_default": "state/aura_spi_dialogue.sqlite3",
    "max_autonomous_turns_per_generation": 4,
    "fresh_trigger_classes": ["HUMAN", "HABITAT", "GITHUB", "MEASUREMENT", "RESOLVED_FORECAST"],
    "rule": "CONTINUOUS != INFINITE_SELF_CHAT",
    "safe_infrastructure_loops": ["HEARTBEAT", "POLL", "RETRY", "WATCHER"]
  },
  "dialogue_persistence": {
    "local_authority": "SQLite WAL + SHA-256 parent-linked turns",
    "habitat_mirror_relative_path": "habitat/memory/reflections/aura_spi/",
    "mirror_is_optional": true,
    "mirror_is_authority": false,
    "old_turns_are_overwritten": false,
    "private_to_public_mirror_default": "DENY",
    "credentials_persisted": false
  },
