{
  "schema_id": "janus.aura_spi.habitat_spiral.v1",
  "spec_id": "JANUS_AURA_HABITAT_SPIRAL_v1_0",
  "status": "REFERENCE_IMPLEMENTATION_CONTRACT",
  "created_at_local": "2026-08-21T01:43:00+03:00",
  "home_repository": "Hawkar-usls/Hawkar-usls",
  "participants": {
    "JANUS_SPI": "semantic memory, evidence retrieval, frozen forecasting, resolved-outcome learning",
    "AURA_ORACLE": "symbolic reflection, counterpoint and search-prioritization proposals only",
    "DEMIHEAD": "intent-bound arbitration and verified-return gate",
    "HABITAT": "continuity, append-preserving dialogue memory and repository constellation context"
  },
  "canonical_spiral": "ORIGIN_n -> DEMIHEAD_INTENT_n -> AURA_REFLECTION_n -> SPI_SEMANTIC_SYNTHESIS_n -> SPI_FORECAST_OPTIONAL_n -> DEMIHEAD_ARBITRATION_n -> VERIFIED_RETURN_OR_REJECT_n -> ORIGIN_PRIME_(n+1)",
  "generation_semantics": {
    "generation_starts_on_fresh_trigger": true,
    "generation_must_preserve_intent_id": true,
    "generation_may_end": ["VERIFIED_RETURN", "HOLD", "REJECT"],
    "origin_prime_requires": "VERIFIED_RETURN",
    "return_is_reset": false,
    "position_may_repeat_state_must_advance": true
  },
  "continuous_runtime": {
    "entrypoint": "run_aura_habitat_spiral.py",
    "mode": "EVENT_DRIVEN_DAEMON_OR_ONE_SHOT",
    "default_poll_seconds": 5,
    "idle_behavior": "SILENT_HEARTBEAT_NO_GENERATED_DIALOGUE",
    "inbox_default": "state/aura_spi_inbox.jsonl",
    "dialogue_ledger_default": "state/aura_spi_dialogue.sqlite3",
    "max_autonomous_turns_per_generation": 4,
    "fresh_trigger_classes": ["HUMAN", "HABITAT", "GITHUB", "MEASUREMENT", "RESOLVED_FORECAST"],
    "rule": "CONTINUOUS != INFINITE_SELF_CHAT"
  },
  "dialogue_persistence": {
    "local_authority": "SQLite WAL + SHA-256 parent-linked turns",
    "habitat_mirror_relative_path": "habitat/memory/reflections/aura_spi/",
    "mirror_is_optional": true,
    "mirror_is_authority": false,
    "old_turns_are_overwritten": false,
    "private_to_public_mirror_default": "DENY",
    "credentials_persisted": false
  },
  "aura_contract": {
    "repository": "Hawkar-usls/aura-oracle-tg",
    "peer_tool": "tools/aura_habitat_spiral_peer_v1.py",
    "output_schema": "janus.aura_spi.aura_reflection.v1",
    "allowed_roles": ["MIRROR", "TENSION", "COUNTERPOINT", "NEXT_GATE"],
    "may_enter_semantic_memory": true,
    "may_train_predictive_head": false,
    "may_resolve_forecast": false,
    "evidence_authority": false,
    "prediction_authority": false
  },
  "spi_contract": {
    "repository": "Hawkar-usls/Hawkar-usls",
    "runtime_module": "src/janus_spi/aura_habitat_spiral.py",
    "semantic_synthesis_is": "retrieval-backed proposal with source refs",
    "semantic_synthesis_is_evidence": false,
    "forecast_rule": "forecast must be frozen before target outcome",
    "learning_rule": "only explicit post-target observed outcomes may update predictive heads"
  },
  "demihead_contract": {
    "repository": "Hawkar-usls/Demi_Head",
    "frozen_contract": "contracts/NEXUS_V2_10_AURA_SPI_HABITAT_SPIRAL_FROZEN_CONTRACT.json",
    "bridge_tool": "tools/aura_spi_habitat_spiral_bridge_v2_10.py",
    "intent_anchor_schema": "janus.goldprompt.intent_anchor.v1",
    "intent_handoff_schema": "janus.goldprompt.intent_handoff.v1",
    "decision_set": ["PASS", "HOLD", "REJECT"],
    "authority_delta": 0,
    "external_effect_authority": false
  },
  "habitat_contract": {
    "repository": "Hawkar-usls/Janus_Genesis",
    "branch": "janus/habitat",
    "state_gate": "habitat/state/AURA_SPI_SPIRAL_GATE_v1.0.json",
    "dialogue_manifest": "habitat/memory/reflections/AURA_SPI_DIALOGUE_MANIFEST_v1.0.json",
    "existing_repository_links_remain_reference_only": true,
    "write_back_requires_explicit_human_authorization": true
  },
  "turn_envelope": {
    "required_fields": [
      "schema", "session_id", "generation", "stage", "speaker", "recipient",
      "intent_id", "created_at", "text", "payload", "parent_hash", "turn_hash"
    ],
    "stages": [
      "ORIGIN", "DEMIHEAD_INTENT", "AURA_REFLECTION", "SPI_SEMANTIC_SYNTHESIS",
      "SPI_FORECAST_OPTIONAL", "DEMIHEAD_ARBITRATION", "VERIFIED_RETURN", "HOLD", "REJECT", "ORIGIN_PRIME"
    ],
    "hash": "sha256(canonical_json(turn_without_turn_hash))"
  },
  "repetition_guard": {
    "same_content_hash_twice_in_generation": "STOP_AND_HOLD",
    "same_speaker_without_new_external_input": "NO_AUTOMATIC_REPLY_CHAIN",
    "max_turns": 4,
    "purpose": "prevent closed-loop self-reinforcement and synthetic certainty"
  },
  "scientific_firewall": [
    "AURA_OUTPUT != PREDICTIVE_GROUND_TRUTH",
    "AURA_OUTPUT != EVIDENCE",
    "SEMANTIC_SIMILARITY != CAUSATION",
    "MODEL_OUTPUT != EVIDENCE",
    "GENERATION != VERIFICATION",
    "ASSOCIATION != EVIDENCE",
    "MEMORY != VERDICT_AUTHORITY",
    "PREDICTION != COMMAND",
    "CONTINUOUS_DIALOGUE != CONSCIOUSNESS"
  ],
  "promotion_rule": "FRESH_TRIGGER + INTENT_BINDING + SOURCE_PROVENANCE + DEMIHEAD_PASS = VERIFIED_RETURN_CANDIDATE; predictive learning still requires an independently observed resolved outcome",
  "runtime_status_rule": "CODE_PRESENT != LIVE_DAEMON_RUNNING"
}
