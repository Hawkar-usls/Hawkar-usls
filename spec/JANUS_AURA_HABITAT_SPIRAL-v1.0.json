  "canonical_spiral": "ORIGIN_n -> DEMIHEAD_INTENT_n -> AURA_5D_REFLECTION_n -> SPI_SEMANTIC_SYNTHESIS_n -> SPI_FORECAST_OPTIONAL_n -> DEMIHEAD_ARBITRATION_n -> VERIFIED_RETURN_OR_HOLD_OR_REJECT_n -> ORIGIN_PRIME_(n+1)",
  "spiral_laws": [
