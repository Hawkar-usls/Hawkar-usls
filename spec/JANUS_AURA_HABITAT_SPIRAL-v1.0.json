  "scientific_firewall": [
    "AURA_OUTPUT != PREDICTIVE_GROUND_TRUTH",
    "AURA_OUTPUT != EVIDENCE",
    "SEMANTIC_SIMILARITY != CAUSATION",
    "MODEL_OUTPUT != EVIDENCE",
    "GENERATION != VERIFICATION",
    "ASSOCIATION != EVIDENCE",
    "MEMORY != VERDICT_AUTHORITY",
