FROM python:3.11-slim

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir -r /app/requirements.txt
COPY src /app/src
COPY run_aura_habitat_bus.py /app/run_aura_habitat_bus.py
COPY run_aura_habitat_spiral.py /app/run_aura_habitat_spiral.py

ENV PYTHONUNBUFFERED=1

CMD ["python", "run_aura_habitat_bus.py", "--help"]
